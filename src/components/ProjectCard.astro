---
import type { CollectionEntry } from 'astro:content';
import BlobImage from './BlobImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
  variant?: 1 | 2 | 3 | 4;
}

const { project, headingLevel: H = 'h3', variant = 1 } = Astro.props;
const { title, client, location, sectors, summary, image, imageAlt } = project.data;
---

<article
  class="group relative flex h-full flex-col"
  data-project-card
  data-sectors={sectors.join(',')}
>
  <BlobImage
    src={image}
    alt={imageAlt}
    variant={variant}
    sizes="(min-width: 1280px) 384px, (min-width: 768px) 30vw, 100vw"
    widths={[400, 640, 800]}
    aspect="aspect-4/3"
  />
  <div class="mt-6 flex flex-1 flex-col">
    <ul class="flex flex-wrap gap-2" aria-label="Sectors">
      {sectors.map((s) => (
        <li class="rounded-full bg-sand px-3 py-1 text-xs font-bold tracking-wide text-bush-green uppercase">
          {s}
        </li>
      ))}
    </ul>
    <H class="mt-3 text-xl leading-snug font-extrabold">
      <a
        href={`/projects/${project.id}/`}
        class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:rounded-3xl focus-visible:after:outline-3 focus-visible:after:outline-offset-4 focus-visible:after:outline-navy"
      >
        {title}
      </a>
    </H>
    <p class="mt-1 text-sm font-bold tracking-wide text-ochre uppercase">{client ?? location}</p>
    <p class="mt-3 leading-relaxed text-muted">{summary}</p>
  </div>
</article>
