---
/**
 * Dismissible Aboriginal and Torres Strait Islander cultural notice, shown on
 * the first visit. Dismissal is remembered in localStorage (guarded with
 * try/catch so private browsing or blocked storage never breaks the page).
 * The <head> of BaseLayout hides it before first paint if already dismissed.
 * Storage key: "nwcr-cultural-notice" (also used in BaseLayout).
 */
---

<div
  id="cultural-notice"
  role="region"
  aria-labelledby="cultural-notice-title"
  class="cultural-notice fixed inset-x-0 bottom-0 z-50 border-t-4 border-gold bg-night text-white shadow-[0_-8px_30px_rgb(0_0_0/0.25)]"
>
  <div class="container-site flex flex-col gap-4 py-4 sm:flex-row sm:items-center sm:gap-8 sm:py-5">
    <p class="text-sm leading-relaxed sm:text-base">
      <strong id="cultural-notice-title" class="font-bold text-gold">
        Cultural notice.
      </strong>
      Aboriginal and Torres Strait Islander people are advised that this website may contain images,
      voices and names of people who have passed away.
    </p>
    <button type="button" class="btn-gold shrink-0 self-start sm:self-center" data-dismiss-notice>
      I understand
    </button>
  </div>
</div>

<style>
  :global(html.notice-dismissed) .cultural-notice {
    display: none;
  }
</style>

<script>
  const KEY = 'nwcr-cultural-notice';
  const notice = document.getElementById('cultural-notice');
  const button = notice?.querySelector<HTMLButtonElement>('[data-dismiss-notice]');

  button?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, 'dismissed');
    } catch {
      // Storage unavailable (private mode, blocked cookies) — dismiss for this page only.
    }
    document.documentElement.classList.add('notice-dismissed');
    document.getElementById('main-content')?.focus({ preventScroll: true });
  });
</script>
