---
/** ISO certification badges, rendered in HTML (no third-party certification marks). */
import { site } from '../config/site';

interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
const dark = tone === 'dark';
---

<ul class:list={['flex flex-wrap gap-4', className]} aria-label="ISO certifications">
  {site.certifications.map((c) => (
    <li
      class:list={[
        'flex items-center gap-3 rounded-full py-2 pr-5 pl-2',
        dark ? 'bg-white/10 text-white' : 'bg-white text-navy shadow-sm ring-1 ring-sand-deep',
      ]}
    >
      <span
        class:list={[
          'grid size-14 shrink-0 place-items-center rounded-full border-[3px] text-center leading-none',
          dark ? 'border-gold' : 'border-bush-green',
        ]}
        aria-hidden="true"
      >
        <span>
          <span class="block text-[0.6rem] font-bold tracking-widest">ISO</span>
          <span class="block text-sm font-extrabold">{c.code.replace('ISO ', '')}</span>
        </span>
      </span>
      <span class="text-sm leading-tight">
        <span class="block font-extrabold">{c.code}</span>
        <span class:list={['block', dark ? 'text-white/85' : 'text-muted']}>{c.label}</span>
      </span>
    </li>
  ))}
</ul>
