---
/**
 * Provider-agnostic contact form. It POSTs to PUBLIC_FORM_ENDPOINT (Formspree,
 * Web3Forms, Basin…). Without that variable, the email address is shown instead.
 * Spam protection: a honeypot field (`_gotcha`, which Formspree also honours).
 */
import { getCollection } from 'astro:content';
import { mailto, site } from '../config/site';
import Icon from './Icon.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim();
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY?.trim();
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

{endpoint ? (
  <div class="contact-form-wrapper">
    <form
      action={endpoint}
      method="post"
      novalidate
      class="space-y-6"
      data-contact-form
      aria-describedby="form-required-note"
    >
      <p id="form-required-note" class="text-sm text-muted">
        Fields marked <span class="font-bold">(required)</span> must be completed.
      </p>

      <div
        class="hidden rounded-2xl border-2 border-ochre bg-white p-5"
        role="alert"
        tabindex="-1"
        data-error-summary
      >
        <h3 class="font-extrabold text-ochre">Please check the form</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5" data-error-list />
      </div>

      {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
      <input type="hidden" name="_subject" value="Website enquiry — NWCR" />

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="field">
          <label for="cf-name">
            Name <span class="req">(required)</span>
          </label>
          <input
            id="cf-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-describedby="cf-name-error"
          />
          <p id="cf-name-error" class="field-error" hidden />
        </div>
        <div class="field">
          <label for="cf-company">Company</label>
          <input id="cf-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="cf-email">
            Email <span class="req">(required)</span>
          </label>
          <input
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="cf-email-error"
          />
          <p id="cf-email-error" class="field-error" hidden />
        </div>
        <div class="field">
          <label for="cf-phone">Phone</label>
          <input
            id="cf-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            aria-describedby="cf-phone-error"
          />
          <p id="cf-phone-error" class="field-error" hidden />
        </div>
      </div>

      <div class="field">
        <label for="cf-service">Service of interest</label>
        <select id="cf-service" name="service">
          <option value="">Select a service (optional)</option>
          {services.map((s) => (
            <option value={s.data.title} data-slug={s.id}>
              {s.data.title}
            </option>
          ))}
          <option value="Other / not sure">Other / not sure</option>
        </select>
      </div>

      <div class="field">
        <label for="cf-message">
          Message <span class="req">(required)</span>
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="6"
          required
          aria-describedby="cf-message-error"
        />
        <p id="cf-message-error" class="field-error" hidden />
      </div>

      <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it in. -->
      <div class="honeypot" aria-hidden="true">
        <label for="cf-website">Leave this field empty</label>
        <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <button type="submit" class="btn-primary" data-submit>
          Send enquiry <Icon name="arrow" class="size-4" />
        </button>
        <p class="text-sm text-muted">
          Or email{' '}
          <a href={mailto('Website enquiry')} class="link">
            {site.email}
          </a>
        </p>
      </div>

      <div
        class="hidden rounded-2xl border-2 border-ochre bg-white p-5"
        role="alert"
        data-send-error
      >
        <p class="font-bold text-ochre">Sorry — your message could not be sent.</p>
        <p class="mt-1">
          Please try again. You can also email us at{' '}
          <a href={mailto('Website enquiry')} class="link">
            {site.email}
          </a>{' '}
          or call{' '}
          <a href={`tel:${site.phone.e164}`} class="link">
            {site.phone.display}
          </a>
        </p>
      </div>
    </form>

    <div class="hidden rounded-4xl bg-sand p-8 sm:p-10" role="status" tabindex="-1" data-success>
      <Icon name="check" class="size-10 text-bush-green" />
      <h3 class="mt-4 text-2xl font-extrabold">Thank you — your enquiry has been sent</h3>
      <p class="mt-3 text-lg leading-relaxed">
        A member of our team will be in touch soon. For anything urgent, call us on{' '}
        <a href={`tel:${site.phone.e164}`} class="link">
          {site.phone.display}
        </a>
      </p>
    </div>
  </div>
) : (
  <div class="rounded-4xl bg-sand p-8 sm:p-10">
    <h3 class="text-2xl font-extrabold">Send us an email</h3>
    <p class="mt-3 text-lg leading-relaxed">
      Tell us about your project, the service you need and your timeframe, and our team will get
      back to you.
    </p>
    <a href={mailto('Website enquiry')} class="btn-primary mt-6">
      <Icon name="mail" class="size-4" /> {site.email}
    </a>
  </div>
)}

<style>
  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .field .req {
    font-weight: 500;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .field input,
  .field select,
  .field textarea {
    display: block;
    width: 100%;
    min-height: 3rem;
    border-radius: 0.875rem;
    border: 2px solid #8a8378;
    background: #fff;
    padding: 0.7rem 1rem;
    font: inherit;
    color: var(--color-ink);
    transition: border-color 0.15s;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-navy);
    outline: 3px solid var(--color-gold);
    outline-offset: 1px;
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-ochre);
  }
  .field-error {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ochre-dark);
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const wrapper = form.closest('.contact-form-wrapper');
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const summaryList = form.querySelector<HTMLUListElement>('[data-error-list]');
    const sendError = form.querySelector<HTMLElement>('[data-send-error]');
    const success = wrapper?.querySelector<HTMLElement>('[data-success]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');

    // Pre-select the service when arriving from a service page (?service=rail).
    const slug = new URLSearchParams(window.location.search).get('service');
    if (slug) {
      const option = form.querySelector<HTMLOptionElement>(
        `#cf-service option[data-slug="${CSS.escape(slug)}"]`,
      );
      if (option) option.selected = true;
    }

    type Check = { id: string; test: (v: string) => string | null };
    const checks: Check[] = [
      { id: 'cf-name', test: (v) => (v ? null : 'Enter your name.') },
      {
        id: 'cf-email',
        test: (v) =>
          !v
            ? 'Enter your email address.'
            : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)
              ? null
              : 'Enter an email address in the format name@example.com.',
      },
      {
        id: 'cf-phone',
        test: (v) =>
          !v || /^[+()\d\s-]{8,20}$/.test(v)
            ? null
            : 'Enter a phone number using digits, spaces and + only.',
      },
      { id: 'cf-message', test: (v) => (v ? null : 'Enter a message.') },
    ];

    const setError = (input: HTMLElement, message: string | null) => {
      const error = document.getElementById(`${input.id}-error`);
      input.setAttribute('aria-invalid', String(Boolean(message)));
      if (error) {
        error.textContent = message ?? '';
        error.hidden = !message;
      }
    };

    const validate = () => {
      const errors: { id: string; message: string }[] = [];
      for (const { id, test } of checks) {
        const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        if (!input) continue;
        const message = test(input.value.trim());
        setError(input, message);
        if (message) errors.push({ id, message });
      }
      return errors;
    };

    // After a first failed submit, re-check each field as the user types (not on blur,
    // which would move the Submit button mid-click when an error message disappears).
    let submitted = false;
    for (const { id, test } of checks) {
      const input = document.getElementById(id) as HTMLInputElement | null;
      input?.addEventListener('input', () => {
        if (submitted) setError(input, test(input.value.trim()));
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitted = true;
      sendError?.classList.add('hidden');

      const errors = validate();
      if (errors.length && summary && summaryList) {
        summaryList.replaceChildren(
          ...errors.map(({ id, message }) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#${id}`;
            a.className = 'link';
            a.textContent = message;
            a.addEventListener('click', (e) => {
              e.preventDefault();
              document.getElementById(id)?.focus();
            });
            li.append(a);
            return li;
          }),
        );
        summary.classList.remove('hidden');
        summary.focus();
        return;
      }
      summary?.classList.add('hidden');

      const data = new FormData(form);
      // Honeypot filled in: pretend success, send nothing.
      if (String(data.get('_gotcha') ?? '') !== '') {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
      }
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Form endpoint returned ${response.status}`);
        form.reset();
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        success?.focus();
      } catch {
        sendError?.classList.remove('hidden');
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
        }
      }
    });
  }
</script>
