---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import OvalTrail from '../../components/OvalTrail.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SplitHeading from '../../components/SplitHeading.astro';
import { site } from '../../config/site';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const otherServices = allServices.filter((s) => s.id !== service.id);

const related = d.relatedSectors.length
  ? (
      await getCollection('projects', (p) =>
        p.data.sectors.some((s) => d.relatedSectors.includes(s)),
      )
    )
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 3)
  : [];
---

<BaseLayout title={d.title} description={d.summary}>
  <PageHero
    light={d.heading.light}
    bold={d.heading.bold}
    image={d.image}
    imageAlt={d.imageAlt}
    blob={((d.order % 4) + 1) as 1 | 2 | 3 | 4}
    breadcrumbs={[{ label: 'Services', href: '/services/' }, { label: d.title }]}
  >
    {d.credential && (
      <p class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold text-bush-green shadow-sm ring-1 ring-sand-deep">
        <Icon name="check" class="size-4" />
        {d.credential}
      </p>
    )}
  </PageHero>

  <section aria-labelledby="overview-heading" class="on-light py-16 sm:py-24">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 id="overview-heading" class="sr-only">
          Overview
        </h2>
        <div class="prose-nwcr">
          <Content />
        </div>
        <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row lg:flex-col">
          <a href={`/contact/?service=${service.id}`} class="btn-primary">
            Enquire about {d.title} <Icon name="arrow" class="size-4" />
          </a>
          {site.capabilityStatement.enabled && (
            <a href={site.capabilityStatement.href} class="btn-outline-navy">
              <Icon name="document" class="size-4" /> Capability Statement
            </a>
          )}
        </div>
      </div>

      <div class="space-y-8 lg:col-span-7">
        <div class="rounded-4xl bg-sand p-7 sm:p-10">
          <h2 class="text-2xl font-extrabold">{d.capabilitiesHeading}</h2>
          <ul class="tick-list mt-7 sm:grid-cols-2">
            {d.capabilities.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
        {d.secondaryList && (
          <div class="rounded-4xl bg-night p-7 text-white sm:p-10">
            <h2 class="text-2xl font-extrabold text-white">{d.secondaryList.heading}</h2>
            <ul class="tick-list tick-list-light mt-7 sm:grid-cols-2">
              {d.secondaryList.items.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section aria-labelledby="related-heading" class="on-light bg-sand py-20 sm:py-24">
      <div class="container-site">
        <SplitHeading id="related-heading" light="Related" bold="Projects" />
        <ul class="mt-12 grid gap-14 md:grid-cols-3 md:gap-8 lg:gap-12">
          {related.map((p, i) => (
            <li>
              <ProjectCard project={p} variant={(((i + 1) % 4) + 1) as 1 | 2 | 3 | 4} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="other-services-heading" class="on-light py-20 sm:py-24">
    <div class="container-site">
      <OvalTrail tone="navy" count={9} class="mb-8 w-48" />
      <h2 id="other-services-heading" class="text-2xl font-extrabold sm:text-3xl">
        Explore our other services
      </h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {otherServices.map((s) => (
          <li>
            <a
              href={`/services/${s.id}/`}
              class="flex h-full items-center justify-between gap-3 rounded-2xl bg-white px-5 py-4 font-bold text-navy shadow-sm ring-1 ring-sand-deep transition hover:bg-sand"
            >
              {s.data.title}
              <Icon name="arrow" class="size-4 text-bush-green" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .tick-list-light :global(li)::before {
    border-color: var(--color-gold);
  }
</style>
