# Form endpoint for the contact form (Formspree, Web3Forms, Basin, etc.).
# Example (Formspree): https://formspree.io/f/abcdwxyz
# If left empty, the contact page shows the email address instead of the form.
PUBLIC_FORM_ENDPOINT=

# Optional: Web3Forms access key (only needed if PUBLIC_FORM_ENDPOINT is https://api.web3forms.com/submit)
PUBLIC_FORM_ACCESS_KEY=
